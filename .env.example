# Copy this file to .env and fill in values for local development.
# The server loads .env automatically on startup (via godotenv).
# Never commit .env — it is in .gitignore.

# HTTP / gRPC ports (defaults shown)
# PORT=8080
# GRPC_PORT=9090

# Database path (default: ./zkid.db)
# DB_PATH=./zkid.db

# Verifying-key directory (auto-downloaded on first run)
# KEYS_DIR=./keys

# CORS allowed origin (default: *)
# CORS_ORIGIN=*

# Application's stable app_id (REQUIRED). 62-char lowercase hex of 31 raw bytes.
# These are the bytes the prover signs; the device_sig circuit exposes them as
# 31 public field elements and the verifier compares them against this value
# in constant time. Generate with: openssl rand -hex 31
# APP_ID=

# SMT root enforcement: strict | disabled (disabled skips onchain check — dev only)
# SMT_ROOT_ENFORCE=strict

# Issuer cert enforcement: strict | disabled
# ISSUER_CERT_ENFORCE=strict

# Dev/test only: expose POST /debug/db/clean behind Bearer auth.
# Generate with: openssl rand -hex 32
# Leave unset (or remove this line) in production.
# DEBUG_TOKEN=
